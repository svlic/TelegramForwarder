######### 必填项 #########
# Telegram API 配置 (从 https://my.telegram.org/apps 获取)
API_ID=
API_HASH=

# 用户账号登录用的手机号 (格式如: +8613812345678)
PHONE_NUMBER=

# Bot Token (从 @BotFather 获取)
BOT_TOKEN=

# 用户ID (从 @userinfobot 获取)
USER_ID=


######### AI 配置 #########
# AI 模型列表 (逗号分隔，如: gpt-4o,claude-3-sonnet,gemini-2.0-flash) - 用户自定义
AI_MODELS=

# 自定义 OpenAI 兼容接口 (必填)
CUSTOM_AI_API_KEY=
CUSTOM_AI_API_BASE=


######### 可选项 #########
# 管理员列表 (留空默认 USER_ID，多个用逗号分隔)
ADMINS=

# 数据库连接 (留空使用默认 sqlite:///./db/forward.db)
DATABASE_URL=

# 默认时区
DEFAULT_TIMEZONE=Asia/Shanghai

# 是否开启 UFB 联动 (true/false)
UFB_ENABLED=false
UFB_SERVER_URL=
UFB_TOKEN=

######### 必填项 #########
# Telegram API 配置 (从 https://my.telegram.org/apps 获取)
API_ID=
API_HASH=

# 用户账号登录用的手机号 (格式如: +8613812345678)
PHONE_NUMBER=

# Bot Token (从 @BotFather 获取)
BOT_TOKEN=

# 用户ID (从 @userinfobot 获取)
USER_ID=


######### AI 配置 #########
# AI 模型列表 (逗号分隔，如: gpt-4o,claude-3-sonnet,gemini-2.0-flash)
AI_MODELS=

# OpenAI API Key (留空使用官方接口)
OPENAI_API_KEY=
OPENAI_API_BASE=

# Claude API Key (留空使用官方接口)
CLAUDE_API_KEY=
CLAUDE_API_BASE=

# Gemini API Key
GEMINI_API_KEY=
# Gemini API Base (留空使用官方接口)
GEMINI_API_BASE=

# DeepSeek API Key (留空使用官方接口)
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=

# Qwen API Key (留空使用官方接口)
QWEN_API_KEY=
QWEN_API_BASE=

# Grok API Key (留空使用官方接口)
GROK_API_KEY=
GROK_API_BASE=


######### 可选项 #########
# 管理员列表 (留空默认 USER_ID，多个用逗号分隔)
ADMINS=

# 数据库连接 (留空使用默认 sqlite:///./db/forward.db)
DATABASE_URL=

# 默认时区
DEFAULT_TIMEZONE=Asia/Shanghai

# 是否开启 UFB 联动 (true/false)
UFB_ENABLED=false
UFB_SERVER_URL=
UFB_TOKEN=
